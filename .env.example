# Notion Integration
NOTION_API_KEY="your_notion_api_key_here"
NOTION_DATABASE_ID="your_database_id_here"

# Admin API Key (for /admin, /admin/confirm, /admin/cancel)
ADMIN_KEY="your_secure_admin_password"

# Flask secret key (stable across restarts)
FLASK_SECRET_KEY="change-me-to-a-random-string"

# Telegram Notifications (for photographer)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# Google Calendar (optional)
GCAL_HELPER=""
BOOKING_CALENDAR_ID="iryna.pashynska@gmail.com"
BOOKING_CALENDAR_TZ="America/Edmonton"

# Stripe (card payments — optional, Interac e-Transfer works without this)
# Get keys from: https://dashboard.stripe.com/apikeys
# Get webhook secret from: https://dashboard.stripe.com/webhooks
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Website AI assistant (optional)
# Build sanitized knowledge from the Instagram export:
# python3 scripts/build_assistant_knowledge.py /path/to/instagram-export.zip
AI_PROVIDER="zai"
ZAI_API_KEY=""
ZAI_MODEL="glm-4.5-air"
ZAI_THINKING="disabled"
ZAI_CHAT_COMPLETIONS_URL="https://api.z.ai/api/paas/v4/chat/completions"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
ASSISTANT_KNOWLEDGE_PATH="/data/assistant_knowledge.jsonl"
ASSISTANT_MAX_KNOWLEDGE="10000"
ASSISTANT_SITE_URL="https://pashynska.agency"
