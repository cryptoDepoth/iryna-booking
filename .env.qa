# QA Nightly Test Environment
# Copy to .env.qa and fill in

# Test target
TEST_BASE_URL=http://127.0.0.1:5001
# For production tests (use with extreme care):
# TEST_BASE_URL=https://book.pashynskaphoto.com

# Admin credentials for admin flow tests
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Hawanj100

# Telegram bot for notifications
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
TELEGRAM_CHAT_ID=792920251

# QA synthetic data identifiers
QA_EMAIL_PREFIX=qa-test
QA_NAME_PREFIX=QA Test
QA_PHONE=403-555-0100

# Database path (for direct assertions)
DB_PATH=/Users/andrzej/.pashynska-data/bookings.db

# Test timeouts
RESERVE_TIMEOUT_SECONDS=30
POLL_INTERVAL_SECONDS=2
MAX_POLL_ATTEMPTS=15

# Retry configuration
MAX_TEST_RETRIES=2
RETRY_DELAY_SECONDS=5

# Rate limiting
REQUEST_DELAY_MS=500
